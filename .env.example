# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:  copy .env.example .env (Windows) หรือ cp .env.example .env (macOS)

# ── ตัวตัดสินใจ (Jev หรือ LLM แทนอัตโนมัติ) ────────────────────
# คีย์ของ TypeSafe (โมเดล Jev) ขอได้ที่ https://typesafe.ai (เว้นว่างได้! ถ้าไม่ใส่ จะใช้โมเดลจาก TOGETHER_API_KEY / LLM ที่ตั้งไว้ด้านล่างตัดสินใจแทนอัตโนมัติ)
TYPESAFE_API_KEY=

# ── สมองส่วนคุย (ตอบคำถาม + ขับเบราว์เซอร์) ─────────────────
# local = รันในเครื่อง (บน Mac ใช้ mlx_lm.server, บน Windows ใช้ Ollama พอร์ต 11434 หรือ LM Studio พอร์ต 1234)
# cloud = ใช้ OpenRouter หรือ Google Gemini ตามคีย์ด้านล่าง
LLM_MODE=cloud
LOCAL_LLM_MODEL=scb10x/llama3.1-typhoon2-8b-instruct
LOCAL_LLM_PORT=11434
# ใช้เมื่อ LLM_MODE=cloud — ลำดับความสำคัญ: OPENROUTER_API_KEY > TOGETHER_API_KEY > GOOGLE_API_KEY
OPENROUTER_API_KEY=
# คีย์ Together AI https://api.together.ai/settings/api-keys (ใช้ถ้าไม่มี OPENROUTER_API_KEY)
TOGETHER_API_KEY=
# คีย์ Google AI Studio (Gemini) https://aistudio.google.com/apikey (รุ่นฟรีมีเพดานต่อนาทีต่ำ)
GOOGLE_API_KEY=
# โมเดล cloud เว้นว่าง = ค่าเริ่มต้น (OpenRouter: anthropic/claude-haiku-4.5, TogetherAI: Qwen/Qwen3.5-9B, Google: gemini-3.5-flash-lite)
LLM_MODEL=Qwen/Qwen3.5-9B
AGENT_MODEL=

# โมเดลตัดสินใจของ TypeSafe
JEV_MODEL=jev-latest
# ความมั่นใจขั้นต่ำ (0-1) ต่ำกว่านี้จะขอให้พูดใหม่
CONF_MIN=0.65
# ความน่าจะเป็นขั้นต่ำว่าเป็นคำสั่งซ้อน ถึงจะถามรอบสอง (สเปก 0.5 · วัดแล้วแนะนำ 0.75 กันประโยคเดี่ยวถูกแยกผิด)
COMPOUND_MIN=0.5

# ── เสียงพูด ──────────────────────────────────────────────
# เสียง: บน Windows ใช้ edge-tts (th-TH-NiwatNeural = เสียงผู้ชาย, th-TH-PremwadeeNeural = เสียงผู้หญิง)
#        บน macOS ใช้ say (Kanya) · ความเร็ว (180 = ปกติ, 205 = เร็วกำลังดี, 230 = เร็วมาก, 162 = ช้าลง 10%)
TTS_VOICE=th-TH-NiwatNeural
TTS_RATE=205
# ระดับเสียง: บน macOS 28 ≈ ทุ้มแบบผู้ชาย · บน Windows เว้นว่างได้เพราะ NiwatNeural เป็นเสียงผู้ชายอยู่แล้ว
TTS_PITCH=

# ── การฟังและการคุย ──────────────────────────────────────
# คำปลุก: ต้องเรียกชื่อนี้ก่อนสั่ง (คั่นหลายคำด้วย ,) ใส่ off = ฟังทุกประโยคโดยไม่ต้องเรียกชื่อ
WAKE_WORD=จางวิท
# หลังคุยกันแล้ว คุยต่อได้กี่วินาทีโดยไม่ต้องเรียกชื่อซ้ำ (นับจากตอนจางวิทพูดจบ)
CONVO_SEC=30
# การพูดแทรกตอนจางวิทกำลังพูด: auto = เปิดเมื่อมีตัวตัดเสียงสะท้อน (AEC), on = เปิดเสมอ (ใส่หูฟัง), off = ปิด
BARGE_IN=auto
# ความเงียบกี่มิลลิวินาทีถึงถือว่าจบประโยค (น้อย = ตอบไว แต่อาจตัดกลางประโยค)
SILENCE_MS=550
# เกณฑ์ความน่าจะเป็นว่าเป็นเสียงพูด (0-1) ห้องเสียงดังให้เพิ่มขึ้น
VAD_THRESHOLD=0.5
# สั่งเปิด/ปิดได้ทุกแอปที่ติดตั้งในเครื่อง: auto / off
EXTRA_APPS=auto

# ── หน้าจอ ────────────────────────────────────────────────
# ไอคอนไมค์บนแถบเมนูด้านบน และหน้าจอ J.A.R.V.I.S ลอยบนจอ: on / off
MENUBAR=on
HUD=on

# ── ถอดเสียง ───────────────────────────────────────────
# ตัวหลัก: auto = ตัวถอดเสียงไทยของ Apple ในเครื่อง (macOS 26+, ไม่ต้องขอสิทธิ์, แม่นกว่า Whisper มากกับเสียงจริง)
#          ถ้าใช้ไม่ได้จะใช้ Whisper · apple = บังคับใช้ของ Apple · whisper = ใช้ Whisper อย่างเดียว
STT_ENGINE=auto
# (ของ Apple ต้องมีภาษาไทยใน System Settings › Keyboard › Dictation และ Command Line Tools สำหรับคอมไพล์ครั้งแรก)
# รุ่นหลัก (MLX) เปลี่ยนเป็น chayapats/typhoon-whisper-turbo-mlx ได้ (จูนภาษาไทย ขนาดเท่ากัน)
MLX_WHISPER_REPO=mlx-community/whisper-large-v3-turbo
# คำใบ้ชื่อแอป/คำปลุกให้ Whisper: auto (ปิดเองกับรุ่น Typhoon) / on / off
WHISPER_PROMPT_MODE=auto
# ความเห็นที่สอง: เรียกชื่อแล้วแต่ Jev ไม่มั่นใจ → ถอดซ้ำด้วยรุ่นที่จูนไทย
# auto = ใช้ถ้าดาวน์โหลด Typhoon ไว้แล้ว, off = ปิด, หรือใส่ชื่อ repo MLX
STT_SECOND_OPINION=auto
# ใส่ชื่อโฟลเดอร์เพื่อเก็บเสียงแต่ละประโยคเป็น WAV ไว้ทดสอบ (เว้นว่าง = ไม่เก็บ)
SAVE_UTTERANCES=
# ข้อความที่ได้ยินแต่ไม่ได้เรียกจางวิท (เช่น คนในบ้านคุยกัน): เว้นว่าง = log บอกแค่ความยาว · all = พิมพ์ข้อความด้วย
LOG_HEARD=
# เปิด Chrome ด้วยโปรไฟล์ไหน (ชื่อที่เห็นใน Chrome หรือชื่อโฟลเดอร์ เช่น Default) เว้นว่าง = โปรไฟล์ที่ใช้ล่าสุด
CHROME_PROFILE=
